import pygame, random, json


# Creates screen
pygame.init()
screen = pygame.display.set_mode((750, 500))
clock = pygame.time.Clock()

text_font = pygame.font.SysFont("segoeuisymbol", 35)
def draw_text(text, font, text_col, x, y):
    img = font.render(text, True, text_col)
    screen.blit(img, (x,y))

game_end = False

width = 750
height = 500

# Position of players 1 and 2
x1 = 0
y1 = 200

x2 = 720
y2 = 200

# Ball
ball_speedy = 7
ball_speedx = 7
ball_y = 250
ball_x = 375

# Score tracking
scored1 = False
scored2 = False

player1_score = 0
player2_score = 0

# Ghost flags to prevent repeated/glitched collisions
paddle_collision_locked = 0
vertical_collision_locked = 0

# Respawn timer placeholder
respawn_timer = 0


choose_difficulty = False
# Default difficulty (medium)
paddle_height = 100
paddle_speed = 4

start = True

choose_save = True

show_save_menu = True           
typing_filename = False         
filename_needs_clear = True     
process_save = False            

filename = ''

running = True
while running:
    clock.tick(60)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if choose_save:
            keys = pygame.key.get_pressed()
            if keys[pygame.K_1] or keys[pygame.K_2]:
                show_save_menu = False
                typing_filename = True
            if typing_filename:
                if event.type == pygame.KEYDOWN:
                    if keys[pygame.K_BACKSPACE]:
                        filename = filename[:-1]
                    elif keys[pygame.K_RETURN]:
                        choose_save = False
                        process_save = True
                        choose_difficulty = True
                    else:
                        filename += event.unicode
                    if filename_needs_clear:
                        filename = ''
                        filename_needs_clear = False

    # Draw game background only when not choosing save/difficulty and not game end
    screen.fill((0,0,0))
    if not choose_difficulty and not choose_save and not game_end:
        pygame.draw.circle(screen,"white", (375, 250), 65)
        pygame.draw.circle(screen,"black", (375, 250), 60)
        pygame.draw.line(screen, "white", (375, 0), (375, 500), 5)


    if choose_save:
        if show_save_menu:
            draw_text("1. New Save", text_font, "white", 300, 150)
            draw_text("2. Load Save", text_font, "white", 300, 220)
        if typing_filename:
            draw_text("Enter save name here:", text_font, 'white', 225, 150)
            draw_text(filename, text_font, 'white', 225, 200)

    if process_save:
        try:
            with open(filename + ".json", "r") as f:
                data = json.load(f)
                player1_score = data.get("player1_score", 0)
                player2_score = data.get("player2_score", 0)
        except FileNotFoundError:
            with open(filename + ".json", "w") as f:
                json.dump({"player1_score": 0, "player2_score": 0}, f)
        process_save = False

    # Difficulty selection screen (1=easy, 2=medium, 3=hard)
    if choose_difficulty and not choose_save:
        draw_text("Choose difficulty:", text_font, "white", 200, 50)
        draw_text("1 - Easy (longer paddles, slower)", text_font, "green", 50, 120)
        draw_text("2 - Medium (default)", text_font, "yellow", 50, 180)
        draw_text("3 - Hard (shorter paddles, faster)", text_font, "red", 50, 240)
        keys = pygame.key.get_pressed()
        if keys[pygame.K_1]:
            paddle_height = 140
            paddle_speed = 3
            choose_difficulty = False
        if keys[pygame.K_2]:
            paddle_height = 100
            paddle_speed = 4
            choose_difficulty = False
        if keys[pygame.K_3]:
            paddle_height = 70
            paddle_speed = 6
            choose_difficulty = False

    # Creates start screen (appears after difficulty chosen)
    if not choose_difficulty and not choose_save and start and not game_end:
        ball_speedx = 0
        ball_speedy = 0
        draw_text("Controls", text_font, "Blue", 100, 50)
        draw_text("W - up", text_font, "blue", 100, 90)
        draw_text("S - down", text_font, "blue", 100, 130)
        draw_text("Controls", text_font, "Red", 475, 50)
        draw_text("Arrow up - up", text_font, "Red", 475, 90)
        draw_text("Arrow down - down", text_font, "Red", 475, 130)
        draw_text("E to start", text_font, "green", 250, 15)
        keys = pygame.key.get_pressed()
        if keys[pygame.K_e]:
            direction_x = random.randint(1, 2)
            direction_y = random.randint(1, 2)
            if direction_x == 1:
                ball_speedx = 7
            else:
                ball_speedx = -7
            if direction_y == 1:
                ball_speedy = 7
            else:
                ball_speedy = -7
            start = False

    # Draws player 1 and 2, along with monitoring movement after choosing difficulty
    if not choose_difficulty and not choose_save and not game_end:
        if not start:
            draw_text("Score: " + str(player1_score), text_font, "blue", 100, 50)
            draw_text("Score: " + str(player2_score), text_font, "red", 545, 50)
        pygame.draw.rect(screen, "blue", pygame.Rect(x1, y1, 30, paddle_height))
        player1 = pygame.Rect(x1, y1, 30, paddle_height)
        edge1 = pygame.Rect(x1-30, y1 - 5, 55, paddle_height + 10)

        keys1 = pygame.key.get_pressed()
        if keys1[pygame.K_w] and y1 > 0 and not game_end and not start:
            y1 -= paddle_speed
        if keys1[pygame.K_s] and y1 < height - paddle_height and not game_end and not start:
            y1 += paddle_speed

        pygame.draw.rect(screen, "red", pygame.Rect(x2, y2, 30, paddle_height))
        player2 = pygame.Rect(x2, y2, 30, paddle_height)
        edge2 = pygame.Rect(x2 + 5, y2 - 5, 55, paddle_height + 10)

        if keys1[pygame.K_UP] and y2 > 0 and not game_end and not start:
            y2 -= paddle_speed
        if keys1[pygame.K_DOWN] and y2 < height - paddle_height and not game_end and not start:
            y2 += paddle_speed

        # Draws ball
        pygame.draw.circle(screen, "green", (ball_x, ball_y), 15)
        ball = pygame.Rect(ball_x-15, ball_y-15, 30, 30)
        # Move ball only during actual gameplay
        if not start and not choose_difficulty and not game_end:
            ball_y += ball_speedy
            ball_x -= ball_speedx

    # Collision and scoring 
    if not start and not choose_difficulty and not choose_save and not game_end:
        # Reset ghost flags when ball well within play area
        if ball_y > 35 and ball_y < 465:
            vertical_collision_locked = 0
        if abs(ball_x - 375) < 15:
            paddle_collision_locked = 0

        # Top/bottom border collision
        if (ball_y <= 15 and vertical_collision_locked == 0) or (ball_y >= 485 and vertical_collision_locked == 0):
            vertical_collision_locked = 1
            ball_speedy = -ball_speedy

        # Collisions to adjust vertical bounce near paddle ends
        alt_c1 = pygame.Rect.colliderect(edge1, ball)
        if alt_c1:
            vertical_collision_locked = 0
            zone_margin = int(paddle_height * 0.1)
            top_thresh = y1 + zone_margin
            bottom_thresh = y1 + paddle_height - zone_margin
            if ball_y < top_thresh:
                ball_y = y1 - 15
                if ball_speedy > 0:
                    ball_speedy = -ball_speedy
            elif ball_y > bottom_thresh:
                ball_y = y1 + paddle_height + 15
                if ball_speedy < 0:
                    ball_speedy = -ball_speedy

        alt_c2 = pygame.Rect.colliderect(edge2, ball)
        if alt_c2:
            vertical_collision_locked = 0
            # Same logic for player 2 paddle
            zone_margin = int(paddle_height * 0.1)
            top_thresh = y2 + zone_margin
            bottom_thresh = y2 + paddle_height - zone_margin
            if ball_y < top_thresh:
                ball_y = y2 - 15
                if ball_speedy > 0:
                    ball_speedy = -ball_speedy
            elif ball_y > bottom_thresh:
                ball_y = y2 + paddle_height + 15
                if ball_speedy < 0:
                    ball_speedy = -ball_speedy

        # Straight paddle collisions (horizontal bounce)
        collide1 = pygame.Rect.colliderect(player1, ball)
        if collide1 and paddle_collision_locked == 0:
            paddle_collision_locked = 1
            ball_x = x1 + 46
            ball_speedx = -ball_speedx

        collide2 = pygame.Rect.colliderect(player2, ball)
        if collide2 and paddle_collision_locked == 0:
            paddle_collision_locked = 1
            ball_x = x2 - 16
            ball_speedx = -ball_speedx

        # Records who scored, sets up game for next round
        if ball_x < 0:
            scored2 = True
        if ball_x > width:
            scored1 = True

        if scored1 or scored2:
            draw_text(str(respawn_timer), text_font, "green", 340, 25)
            ball_x = 375
            ball_y = 250
            ball_speedy = 0
            ball_speedx = 0
            respawn_timer += 1

        if respawn_timer == 1:
            if scored1:
                player1_score += 1
            else:
                player2_score += 1
            with open(filename + ".json", "w") as f:
                json.dump({"player1_score": player1_score, "player2_score": player2_score}, f)


        if respawn_timer == 100:
            direction_y = random.randint(1, 2)
            if direction_y == 1:
                ball_speedy = -7
            else:
                ball_speedy = 7
            if scored1:
                ball_speedx = 7
                scored1 = False
            else:
                ball_speedx = -7
                scored2 = False
            respawn_timer = 0

    pygame.display.update()
